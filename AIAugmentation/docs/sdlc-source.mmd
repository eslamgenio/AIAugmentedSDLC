class T1,T2,T3,T4,T5 prep;
class C1,C2,C3,C4 dev;
class B1,B2,B3,B4 build;
class E1,E2,E3,E4,E5 test;
class D1,D2,D3,D4,D5 defect;
class A1,A2,A3,A4 rel;
class O1,O2,O3,O4 ops;
